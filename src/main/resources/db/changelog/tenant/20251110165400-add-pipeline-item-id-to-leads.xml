<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="20251110165400-add-pipeline-item-id-to-leads" author="iqscaffold">
        <addColumn tableName="leads">
            <column name="pipeline_item_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <createIndex tableName="leads" indexName="idx_leads_pipeline_item_id">
            <column name="pipeline_item_id"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="leads" indexName="idx_leads_pipeline_item_id"/>
            <dropColumn tableName="leads" columnName="pipeline_item_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
